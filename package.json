{
	"name": "img-previewer",
	"version": "2.1.7",
	"description": "A light wight javascript image viewing plugin with smooth animation",
	"main": "dist/img-previewer.js",
	"module": "dist/img-previewer.esm.js",
	"unpkg": "dist/img-previewer.min.js",
	"jsdelivr": "dist/img-previewer.min.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/img-previewer.esm.js",
			"require": "./dist/img-previewer.js"
		},
		"./dist/*": "./dist/*"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"*.css",
		"*.less"
	],
	"scripts": {
		"build": "rollup -c && tsc --declaration --emitDeclarationOnly --outDir dist/types",
		"serve": "rollup -c -w",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:yue1123/img-previewer.git"
	},
	"keywords": [
		"image",
		"viewer",
		"preview",
		"javascript-plugin"
	],
	"author": {
		"name": "dh",
		"url": "https://dhwork.top/dh"
	},
	"homepage": "https://github.com/yue1123/img-previewer",
	"license": "MIT",
	"devDependencies": {
		"@rollup/plugin-replace": "^6.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"@rollup/plugin-typescript": "^12.3.1",
		"jsdom": "^30.1.3",
		"less": "^4.9.1",
		"rollup": "^4.65.0",
		"rollup-plugin-postcss": "^4.0.2",
		"tslib": "^2.3.1",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	}
}

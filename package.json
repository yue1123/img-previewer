{
	"name": "img-previewer",
	"version": "3.1.0",
	"description": "Lightweight, dependency-free JavaScript image viewer and lightbox with smooth iOS Photos style zoom animation, wheel and pinch zoom, drag, keyboard shortcuts and i18n",
	"main": "dist/img-previewer.js",
	"module": "dist/img-previewer.esm.js",
	"unpkg": "dist/img-previewer.min.js",
	"jsdelivr": "dist/img-previewer.min.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/img-previewer.esm.js",
			"require": "./dist/img-previewer.js"
		},
		"./dist/*": "./dist/*"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"*.css",
		"*.less"
	],
	"scripts": {
		"build": "rollup -c && tsc --declaration --emitDeclarationOnly --outDir dist/types",
		"serve": "rollup -c -w",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:yue1123/img-previewer.git"
	},
	"keywords": [
		"image-viewer",
		"image-preview",
		"image-previewer",
		"lightbox",
		"gallery",
		"photo-viewer",
		"image-zoom",
		"zoom",
		"pinch-zoom",
		"viewer",
		"preview",
		"image",
		"photo",
		"animation",
		"vanilla-js",
		"javascript",
		"typescript",
		"no-dependencies",
		"javascript-plugin",
		"图片预览"
	],
	"author": {
		"name": "dh",
		"url": "https://dhwork.top/dh"
	},
	"homepage": "https://github.com/yue1123/img-previewer",
	"bugs": {
		"url": "https://github.com/yue1123/img-previewer/issues"
	},
	"license": "MIT",
	"devDependencies": {
		"@rollup/plugin-replace": "^6.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"@rollup/plugin-typescript": "^12.3.1",
		"jsdom": "^30.1.3",
		"less": "^4.9.1",
		"rollup": "^4.65.0",
		"rollup-plugin-postcss": "^4.0.2",
		"tslib": "^2.3.1",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	}
}
